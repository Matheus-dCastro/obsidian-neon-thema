{
  "name": "obsidian-neon-110",
  "displayName": "Obsidian Neon Theme",
  "description": "A dark, high-contrast theme fusing Omni's deep interface with vibrant Dracula neon syntax.",
  "version": "1.2.5",
  "publisher": "Alomyr",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Matheus-dCastro/obsidian-neon-thema.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "PKief.material-icon-theme",
    "usernamehw.errorlens"
  ],
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Obsidian Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/obsidian-neon-color-theme.json"
      },
      {
        "label": "Obsidian Neon (Dracula)",
        "uiTheme": "vs-dark",
        "path": "./themes/obsidian-neon-dracula-color-theme.json"
      },
      {
        "label": "Obsidian Neon (Dracula Syntax)",
        "uiTheme": "vs-dark",
        "path": "./themes/obsidian-neon-dracula-syntax-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "obsidianNeon.applyRecommendedSettings",
        "title": "Obsidian Neon: Ativar Configurações Recomendadas (Inlay Hints, Terminal, etc.)"
      }
    ]
  }
}